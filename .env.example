# Local dev only. Copy to .env (gitignored) for `netlify dev`.
# Production values live in: Netlify dashboard > Site > Environment variables
# (scope GEMINI_API_KEY + DIALOGUE_HMAC_SECRET to Functions / production only
# so Deploy Previews never get a billable key).

# Required: server-only Gemini key (never ship in src/ or dist/).
GEMINI_API_KEY=

# Required in production: random 32+ byte secret signing dialogue receipts
# (binds each player turn to the previously issued choices).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DIALOGUE_HMAC_SECRET=

# Optional: comma-separated allowed browser origins for the dialogue proxy.
# Same-host Origin/Referer always passes; cross-site POSTs are rejected.
# Example: ALLOWED_ORIGINS=https://calleva.example.com
ALLOWED_ORIGINS=

# Optional: set to 1 locally to enable GET /.netlify/functions/dialogue?probe=1.
# Leave unset in production (probe returns 404 there).
# When enabled, the probe returns sanitized debug (model/httpStatus/ms) and
# Talk POST failures also include sanitized debug (stage/attempts) so the
# map-panel LLM tester can show the cause. Disabled = requestId only.
ENABLE_DIALOGUE_PROBE=
